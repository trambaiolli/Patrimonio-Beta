<header class="app-header">
    <div class="container header-grid">
        <a href="/dashboard" class="brand-link">
            <img src="/logo.svg" alt="Logo Sistema de Patrimônio" class="brand-logo">
            <div class="brand-block">
                <span class="brand-eyebrow">Gestão Patrimonial</span>
                <h1>Sistema de Patrimônio</h1>
            </div>
        </a>
        <div class="nav-meta">
            <nav class="nav-links">
                <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'is-active' : '' %>">Dashboard</a>
                <a href="/equipamentos" class="<%= ['equipamentos', 'form', 'importar', 'detalhes'].includes(activePage) ? 'is-active' : '' %>">Equipamentos</a>
            </nav>
            <% if (typeof username !== 'undefined' && username) { %>
            <div class="user-meta">
                <span class="user-chip">
                    <small>Usuário</small>
                    <strong><%= username %></strong>
                </span>
                <a href="/logout" class="btn btn-ghost">Sair</a>
            </div>
            <% } %>
        </div>
    </div>
</header>
