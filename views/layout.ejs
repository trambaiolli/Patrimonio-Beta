<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Sistema de Patrimônio' %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-shell">
    <% if (typeof username !== 'undefined' && username) { %>
        <%- include('partials/header', { activePage: typeof activePage !== 'undefined' ? activePage : '', username }) %>
    <% } %>

    <main class="content-area">
        <%- body %>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
