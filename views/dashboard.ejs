<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sistema de Patrimônio</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-shell">
    <%- include('partials/header', { activePage: 'dashboard', username }) %>

    <main class="content-area dashboard-page">
        <section class="page-header dashboard-intro">
            <div>
                <span class="page-eyebrow">Visão geral</span>
                <h2 class="section-title">Patrimônio</h2>
                <p class="section-subtitle">Resumo do inventário e dos registros recentes.</p>
            </div>
            <div class="header-actions">
                <a href="/equipamentos" class="btn btn-secondary">Consultar inventário</a>
                <% if (!isViewer) { %>
                <a href="/equipamentos/novo" class="btn btn-primary">Novo equipamento</a>
                <% } %>
            </div>
        </section>

        <section class="stats-grid" aria-label="Indicadores do inventário">
            <div class="stat-card">
                <p>Equipamentos cadastrados</p>
                <h3><%= total %></h3>
            </div>
            <div class="stat-card">
                <p>Salas em destaque</p>
                <h3><%= porSala.length %></h3>
            </div>
            <div class="stat-card">
                <p>Responsáveis em destaque</p>
                <h3><%= porEmpresa.length %></h3>
            </div>
        </section>

        <section class="dashboard-grid" aria-label="Distribuição do patrimônio">
            <article class="panel">
                <h2 class="panel-heading panel-heading-compact">Equipamentos por sala</h2>
                <div class="panel-body">
                    <% if (porSala.length === 0) { %>
                        <div class="empty-state">Nenhuma sala cadastrada</div>
                    <% } else { %>
                        <div class="table-wrapper">
                            <table>
                                <thead><tr><th>Sala</th><th>Quantidade</th></tr></thead>
                                <tbody>
                                    <% porSala.forEach(item => { %>
                                        <tr><td><strong><%= item.sala %></strong></td><td><%= item.total %></td></tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </article>

            <article class="panel">
                <h2 class="panel-heading panel-heading-compact">Equipamentos por responsável</h2>
                <div class="panel-body">
                    <% if (porEmpresa.length === 0) { %>
                        <div class="empty-state">Nenhum responsável cadastrado</div>
                    <% } else { %>
                        <div class="table-wrapper">
                            <table>
                                <thead><tr><th>Responsável</th><th>Quantidade</th></tr></thead>
                                <tbody>
                                    <% porEmpresa.forEach(item => { %>
                                        <tr><td><strong><%= item.emp %></strong></td><td><%= item.total %></td></tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </article>
        </section>

        <section class="panel table-card">
            <div class="panel-heading panel-heading-compact">
                <h2>Registros recentes</h2>
                <a href="/equipamentos">Ver todos</a>
            </div>
            <div class="panel-body panel-body-flush">
                <% if (ultimos.length === 0) { %>
                    <div class="empty-state">Nenhum equipamento cadastrado</div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table>
                            <thead><tr><th>NI</th><th>TAG</th><th>Descrição</th><th>Sala</th><th>Responsável</th><th>Ação</th></tr></thead>
                            <tbody>
                                <% ultimos.forEach(equip => { %>
                                    <tr>
                                        <td><strong><%= equip.ni %></strong></td>
                                        <td><%= equip.tag %></td>
                                        <td><%= equip.descricao %></td>
                                        <td><%= equip.sala || '-' %></td>
                                        <td><%= equip.emp || '-' %></td>
                                        <td><a href="/equipamentos/visualizar/<%= encodeURIComponent(equip.ni) %>" class="text-action">Abrir</a></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
