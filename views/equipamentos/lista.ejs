<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipamentos - Sistema de Patrimônio</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-shell equipamentos-page">
    <%- include('../partials/header', { activePage: 'equipamentos', username, search, sala, responsavel, filterQuery, isViewer }) %>

    <main class="content-area">
        <% if (message) { %>
            <div class="alert alert-<%= messageType %>">
                <%= message %>
            </div>
        <% } %>

        <section class="panel">
            <div class="panel-heading panel-heading-compact filter-panel-heading">
                <span>Filtros e busca</span>
                <div class="actions filters-actions">
                    <%
                    const printUrl = '/equipamentos/imprimir-lista?' +
                        (search ? 'search=' + encodeURIComponent(search) + '&' : '') +
                        (sala ? 'sala=' + encodeURIComponent(sala) + '&' : '') +
                        (responsavel ? 'responsavel=' + encodeURIComponent(responsavel) : '');
                    %>
                    <button type="submit" form="equipmentFiltersForm" class="btn btn-primary" title="Aplicar filtros" aria-label="Aplicar filtros">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                            <path d="M3 5h18l-7 8v5l-4 2v-7L3 5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <a href="<%= printUrl %>" class="btn btn-warning" target="_blank" title="Imprimir resultados filtrados" aria-label="Imprimir resultados filtrados">🖨️</a>
                    <a href="/equipamentos" class="btn btn-secondary" title="Limpar filtros" aria-label="Limpar filtros">🧹</a>
                    <a href="/equipamentos/exportar-excel" class="btn btn-secondary" title="Exportar para Excel">📗 Exportar Excel</a>
                    <% if (!isViewer) { %>
                    <a href="/equipamentos/importar" class="btn btn-secondary" title="Importar Excel">Importar Excel</a>
                    <a href="/equipamentos/novo<%= filterQuery ? '?' + filterQuery : '' %>" class="btn btn-primary" title="Adicionar equipamento" aria-label="Adicionar equipamento">+</a>
                    <% } %>
                </div>
            </div>
            <div class="panel-body">
                <form id="equipmentFiltersForm" method="GET" action="/equipamentos" class="filters-form">
                    <div class="field field-wide">
                        <label for="search">Busca geral</label>
                        <input 
                            type="text" 
                            id="search"
                            name="search" 
                            placeholder="Digite NI, TAG ou descrição"
                            value="<%= search %>"
                            class="search-input"
                        >
                    </div>

                    <div class="field">
                        <label for="sala">Sala</label>
                        <select name="sala" id="sala">
                            <option value="">Todas</option>
                            <% salas.forEach(s => { %>
                                <option value="<%= s %>" <%= sala === s ? 'selected' : '' %>><%= s %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="field">
                        <label for="responsavel">Responsável</label>
                        <input
                            type="text"
                            id="responsavel"
                            name="responsavel"
                            placeholder="Digite o responsável"
                            value="<%= responsavel %>"
                            class="search-input"
                        >
                    </div>

                </form>
            </div>
        </section>

        <section class="panel table-card">
            <div class="panel-heading panel-heading-compact">Resultados</div>
            <div class="panel-body">
                <% if (equipamentos.length === 0) { %>
                    <div class="empty-state">
                        <p><%= filterQuery ? 'Nenhum equipamento corresponde aos filtros atuais.' : 'Use os filtros acima para consultar os equipamentos.' %></p>
                        <% if (filterQuery && !isViewer) { %>
                        <a href="/equipamentos/novo" class="btn btn-primary">Cadastrar primeiro equipamento</a>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>NI</th>
                                    <th>TAG</th>
                                    <th>Descrição</th>
                                    <th>Sala</th>
                                    <th>Local</th>
                                    <th>Bloco</th>
                                    <th>Responsável</th>
                                    <th>Observações</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% equipamentos.forEach(equip => { %>
                                    <tr class="equipment-row" data-href="/equipamentos/visualizar/<%= encodeURIComponent(equip.ni) %><%= filterQuery ? '?' + filterQuery : '' %>" tabindex="0" role="link" aria-label="Visualizar equipamento NI <%= equip.ni %>">
                                        <td class="<%= filterQuery ? 'filtered-identifier' : '' %>"><strong><%= equip.ni %></strong></td>
                                        <td class="<%= filterQuery ? 'filtered-identifier' : '' %>"><%= equip.tag %></td>
                                        <td><%= equip.descricao %></td>
                                        <td><%= equip.sala || '-' %></td>
                                        <td><%= equip.local || '-' %></td>
                                        <td><%= equip.bloco || '-' %></td>
                                        <td><%= equip.emp || '-' %></td>
                                        <td><%= equip.obs || '-' %></td>
                                        <td class="actions">
                                            <% if (!isViewer) { %>
                                            <a href="/equipamentos/editar/<%= encodeURIComponent(equip.ni) %><%= filterQuery ? '?' + filterQuery : '' %>" class="btn btn-sm btn-secondary" title="Editar">✏️</a>
                                            <% } %>
                                            <a href="/equipamentos/imprimir/<%= encodeURIComponent(equip.ni) %>" class="btn btn-sm btn-warning" title="Imprimir Etiqueta" target="_blank">🖨️</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="table-info">
                        <p>Total de equipamentos: <strong><%= equipamentos.length %></strong></p>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
    <script>
        document.querySelectorAll('.equipment-row').forEach((row) => {
            row.addEventListener('click', (event) => {
                if (event.target.closest('a, button, input, select, textarea')) return;
                window.location.href = row.dataset.href;
            });

            row.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') window.location.href = row.dataset.href;
            });
        });
    </script>
</body>
</html>
