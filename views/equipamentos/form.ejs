<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= equipamento ? 'Editar' : 'Novo' %> Equipamento - Sistema de Patrimônio</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-shell">
    <%- include('../partials/header', { activePage: 'form', username }) %>

    <main class="content-area">
        <section class="panel">
            <div class="panel-heading">Ficha patrimonial</div>
            <div class="panel-body">
                <div class="page-header">
                    <div>
                        <div class="section-title"><%= equipamento ? 'Editar equipamento' : 'Novo equipamento' %></div>
                        <p class="section-subtitle">Preencha os campos abaixo para manter o controle alinhado ao modelo visual solicitado.</p>
                    </div>
                    <a href="/equipamentos" class="btn btn-secondary">← Voltar</a>
                </div>

                <% if (error) { %>
                    <div class="alert alert-error" style="margin-top: 18px;">
                        <%= error %>
                    </div>
                <% } %>

                <form method="POST" action="<%= equipamento ? '/equipamentos/editar/' + equipamento.ni : '/equipamentos' %>">
                    <div class="sub-panel">
                        <div class="sub-panel-title">Identificação</div>
                        <div class="field-grid">
                            <div class="field">
                                <label for="ni">NI *</label>
                                <input 
                                    type="text"
                                    id="ni"
                                    name="ni"
                                    value="<%= equipamento ? equipamento.ni : '' %>"
                                    <%= equipamento ? 'readonly class="readonly"' : 'required' %>
                                >
                                <% if (equipamento) { %>
                                    <small>O NI não pode ser alterado.</small>
                                <% } %>
                            </div>
                            <div class="field">
                                <label for="tag">TAG *</label>
                                <input type="text" id="tag" name="tag" value="<%= equipamento ? equipamento.tag : '' %>" required>
                            </div>
                            <div class="field" style="grid-column: span 2;">
                                <label for="descricao">Descrição *</label>
                                <input type="text" id="descricao" name="descricao" value="<%= equipamento ? equipamento.descricao : '' %>" required>
                            </div>
                        </div>
                    </div>

                    <div class="sub-panel">
                        <div class="sub-panel-title">Localização</div>
                        <div class="field-grid">
                            <div class="field">
                                <label for="sala">Sala</label>
                                <input type="text" id="sala" name="sala" value="<%= equipamento ? (equipamento.sala || '') : '' %>">
                            </div>
                            <div class="field">
                                <label for="local">Local</label>
                                <input type="text" id="local" name="local" value="<%= equipamento ? (equipamento.local || '') : '' %>">
                            </div>
                            <div class="field">
                                <label for="bloco">Bloco</label>
                                <select id="bloco" name="bloco">
                                    <option value="" <%= !equipamento || !equipamento.bloco ? 'selected' : '' %>>Selecione</option>
                                    <% if (equipamento && equipamento.bloco && !['A', 'B', 'C', 'D', 'E', 'F', 'G'].includes(equipamento.bloco)) { %>
                                        <option value="<%= equipamento.bloco %>" selected><%= equipamento.bloco %></option>
                                    <% } %>
                                    <option value="A" <%= equipamento && equipamento.bloco === 'A' ? 'selected' : '' %>>A</option>
                                    <option value="B" <%= equipamento && equipamento.bloco === 'B' ? 'selected' : '' %>>B</option>
                                    <option value="C" <%= equipamento && equipamento.bloco === 'C' ? 'selected' : '' %>>C</option>
                                    <option value="D" <%= equipamento && equipamento.bloco === 'D' ? 'selected' : '' %>>D</option>
                                    <option value="E" <%= equipamento && equipamento.bloco === 'E' ? 'selected' : '' %>>E</option>
                                    <option value="F" <%= equipamento && equipamento.bloco === 'F' ? 'selected' : '' %>>F</option>
                                    <option value="G" <%= equipamento && equipamento.bloco === 'G' ? 'selected' : '' %>>G</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="sub-panel">
                        <div class="sub-panel-title">Responsabilidade</div>
                        <div class="field-grid">
                            <div class="field">
                                <label for="emp">Emprestimo</label>
                                <input type="text" id="emp" name="emp" value="<%= equipamento ? (equipamento.emp || '') : '' %>">
                            </div>
                        </div>
                    </div>

                    <div class="sub-panel">
                        <div class="sub-panel-title">Observações</div>
                        <div class="field">
                            <label for="obs">Detalhes adicionais</label>
                            <textarea id="obs" name="obs" rows="4"><%= equipamento ? (equipamento.obs || '') : '' %></textarea>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <%= equipamento ? 'Atualizar registro' : 'Cadastrar equipamento' %>
                        </button>
                        <% if (equipamento) { %>
                            <button type="button" id="btnEnviarEmail" class="btn btn-secondary">📧 Enviar por e-mail</button>
                        <% } %>
                        <a href="/equipamentos" class="btn btn-secondary">Cancelar</a>
                    </div>

                    <p class="form-note">Campos marcados com * são obrigatórios.</p>
                </form>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
    <script>
        const salasPorCodigo = {
            A01: ['DIREÇÃO', 'A'],
            A02: ['SALA DE REUNIÕES', 'A'],
            A03: ['COORDENAÇÃO', 'A'],
            A04: ['SECRETARIA', 'A'],
            A05: ['DEPÓSITO DE MATERIAIS - SECRETARIA', 'A'],
            A06: ['AUDITÓRIO', 'A'],
            A07: ['SALA DE AULA - ENSINO MÉDIO', 'A'],
            A08: ['SALA DE AULA - ENSINO MÉDIO', 'A'],
            A09: ['SALA DE AULA - ENSINO MÉDIO', 'A'],
            A10: ['OLIMPIADA - DEV', 'A'],
            A11: ['SALA SERVIDOR', 'A'],
            B01: ['LABORATÓRIO DE INSTALAÇÕES ELÉTRICAS', 'B'],
            B02: ['LABORATÓRIO DE COMANDOS E MÁQUINAS ELÉTRICAS', 'B'],
            B04: ['BIBLIOTECA', 'B'],
            B05: ['REFEITÓRIO', 'B'],
            B06: ['LABORATÓRIO DE ELETRÔNICA', 'B'],
            B07: ['LABORATÓRIO DE AUTOMAÇÃO PREDIAL', 'B'],
            B08: ['SALA DE AULA', 'B'],
            B09: ['LABORATÓRIO DE CLP', 'B'],
            B10: ['LABORATÓRIO DE PROJETOS ELETROELETRÔNICOS', 'B'],
            B11: ['SALA DE AULA', 'B'],
            B12: ['DEPÓSITO DE MATERIAS - ELETROELETRÔNICA', 'B'],
            C01: ['ARQUIVO MORTO DA SECRETARIA', 'C'],
            C02: ['SALA DOS PROFESSORES', 'C'],
            C03: ['DEPÓSITO', 'C'],
            C04: ['LABORATÓRIO DE QUÍMICA, FÍSICA E BIOLOGIA', 'C'],
            C05: ['ANALISTA DE QUALIDADE DE VIDA', 'C'],
            C06: ['SALA DE AULA - ENSINO MÉDIO', 'C'],
            C07: ['SALA DE AULA - ENSINO MÉDIO', 'C'],
            C08: ['SALA DE MÚSICA', 'C'],
            C09: ['SALA DE EXPRESSÃO CORPORAL/ARTES', 'C'],
            C10: ['SALA DE AULA - ENSINO MÉDIO', 'C'],
            C11: ['DEPÓSITO', 'C'],
            C12: ['COMPRESSOR - BLOCO C', 'C'],
            D01: ['SALA DE AULA', 'D'],
            D02: ['SALA DE AULA', 'D'],
            D04: ['OFICINA DE METALURGIA - SOLDAGEM', 'D'],
            D05: ['SALA PPO', 'D'],
            D06: ['DEPÓSITO DE MATERIAIS - SOLDAGEM', 'D'],
            E01: ['LABORATÓRIO DE INFORMÁTICA', 'E'],
            E02: ['LABORATÓRIO DE INFORMÁTICA', 'E'],
            E03: ['SALA DA OLIMPÍADA', 'E'],
            E04: ['LABORATÓRIO DE PROJETOS MECÂNICOS', 'E'],
            E05: ['DEPÓSITO DE MATERIAIS - POLÍMEROS', 'E'],
            E06: ['LABORATÓRIO DE METROLOGIA', 'E'],
            E07: ['LABORATÓRIO DE ENSAIOS E METALOGRAFIA', 'E'],
            E08: ['LABORATÓRIO DE MONTAGEM DE COMPONENTES', 'E'],
            E09: ['DEPÓSITO DE MATERIAS - METALMECÂNICA', 'E'],
            E10: ['LABORATÓRIO DE HIDRÁULICA', 'E'],
            E11: ['SALA DE AULA - DESENHO', 'E'],
            E12: ['SALA DE AULA', 'E'],
            E13: ['SALA DE AULA', 'E'],
            E14: ['LABORATÓRIO DE PNEUMÁTICA', 'E'],
            E15: ['DEPÓSITO DE MATERIAS - INFORMÁTICA', 'E'],
            E16: ['LABORATÓRIO DE MATERIAS POLIMÉRICOS', 'E'],
            E17: ['LABORATÓRIO DE ENSAIOS EM POLÍMEROS', 'E'],
            E18: ['LABORATÓRIO DE PROTOTIPAGEM E CORTE A LASER', 'E'],
            E19: ['SALA DE PPO', 'E'],
            E20: ['SALA DA COORDENAÇÃO', 'E'],
            E21: ['LABORATÓRIO DE CAD / CAM', 'E'],
            E22: ['LABORATÓRIO DE CAD / CAM', 'E'],
            E23: ['OFICINA DE TORNEARIA CNC', 'E'],
            E24: ['OFICINA DE CENTRO DE USINAGEM', 'E'],
            E25: ['OFICINA DE TORNEARIA', 'E'],
            E26: ['OFICINA DE AJUSTAGEM', 'E'],
            E27: ['OFICINA DE INJEÇÃO', 'E'],
            E28: ['OFICINA DE SOPRO E OUTROS PROCESSOS', 'E'],
            E29: ['OFICINA DE MONTAGEM DE MÁQUINAS', 'E'],
            E30: ['OFICINA DE MONTAGEM DE COMPONENTES', 'E'],
            E31: ['ALMOXARIFADO', 'E'],
            E32: ['COMPRESSOR - BLOCO E', 'E'],
            E33: ['DEPÓSITO DE MATERIAIS QUÍMICOS', 'E'],
            F01: ['OFICINA DE CERÂMICA', 'F'],
            G00: ['GINÁSIO', 'G'],
            G01: ['EQUIPAMENTOS SOB CUSTÓDIA DE ALUNO', 'G'],
            G02: ['EQUIPAMENTOS SOB CUSTÓDIA DE FUNCIONARIO', 'G'],
            G03: ['PATRIMONIOS A CLASSIFICAR', 'G'],
            G04: ['EMPRÉSTIMO', 'G']
        };

        const campoSala = document.getElementById('sala');
        const campoLocal = document.getElementById('local');
        const campoBloco = document.getElementById('bloco');
        const campoNi = document.getElementById('ni');
        const campoTag = document.getElementById('tag');
        const campoDescricao = document.getElementById('descricao');
        const campoEmp = document.getElementById('emp');
        const campoObs = document.getElementById('obs');
        const botaoEnviarEmail = document.getElementById('btnEnviarEmail');

        campoSala.addEventListener('input', () => {
            const codigoSala = campoSala.value.trim().toUpperCase();
            const dadosSala = salasPorCodigo[codigoSala];

            campoLocal.value = dadosSala ? dadosSala[0] : '';
            campoBloco.value = dadosSala ? dadosSala[1] : '';
        });

        if (botaoEnviarEmail) {
            botaoEnviarEmail.addEventListener('click', () => {
                const assunto = `Transferência de Patrimônio NI ${campoNi.value.trim()}`;
                const corpo = [
                    'Olá,',
                    '',
                    'Transferência de Patrimônio:',
                    '',
                    `NI: ${campoNi.value.trim()}`,
                    `Descrição: ${campoDescricao.value.trim()}`,
                    `Sala: ${campoSala.value.trim()}`,
                    `Local: ${campoLocal.value.trim()}`,
                    `Bloco: ${campoBloco.value.trim()}`,
                    `Observações: ${campoObs.value.trim()}`,
                    '',
                    'Mensagem enviada pelo Sistema de Patrimônio.'
                ].join('\n');

                const mailtoUrl = `mailto:?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;
                window.location.href = mailtoUrl;
            });
        }
    </script>
</body>
</html>
